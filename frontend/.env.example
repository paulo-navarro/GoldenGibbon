# Frontend environment variables
# Copy to .env.local and adjust for your setup.
# These are only needed if you run the frontend outside Docker (e.g. bare `npm run dev`).
# When running via docker-compose the Vite proxy handles routing automatically.

# Base URL of the FastAPI backend (no trailing slash)
VITE_API_URL=http://localhost:8000

# WebSocket URL of the FastAPI backend
VITE_WS_URL=ws://localhost:8000
